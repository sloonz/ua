default_timeout=30

rss() {
	command 2000 "rss2json \"$1\" | ua-filter -lmdb -lmdb-path ~/.local/share/ua-messages.lmdb | maildir-put -root $HOME/Maildir-feeds -folder \"$2\""
}

mangareader() {
	command 2000 "mangareader2json http://mangareader.net/$1 | "\
		"ua-filter -lmdb -lmdb-path ~/.local/share/ua-messages.lmdb | maildir-put -root $HOME/Maildir-feeds -folder Entertainment"
}

